{
    "name": "mintopia/musicparty",
    "type": "project",
    "description": "Music Party",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.47",
        "guzzlehttp/guzzle": "^7.10",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/ai": "^1.2",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/octane": "^2.21",
        "laravel/prompts": "^0.3.25",
        "laravel/pulse": "^1.8",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/gen-otlp-protobuf": "^1.10",
        "open-telemetry/opentelemetry-auto-laravel": "^1.9",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/transport-grpc": "^1.2",
        "pusher/pusher-php-server": "^7.3",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/laravelpassport": "^4.3",
        "socialiteproviders/spotify": "^4.1",
        "socialiteproviders/steam": "^4.4",
        "socialiteproviders/twitch": "^5.4",
        "spatie/laravel-prometheus": "^1.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "pest --parallel",
        "test:coverage": "pest --parallel --coverage",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "lint": "pint --test",
        "rector": "rector process --dry-run --no-progress-bar",
        "ci": [
            "@lint",
            "@analyse",
            "@rector",
            "@test:coverage"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
