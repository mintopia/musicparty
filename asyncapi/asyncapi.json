{
    "asyncapi": "3.0.0",
    "channels": {
        "party": {
            "address": "party.{code}",
            "messages": {
                "Party.QueueUpdatedEvent": {
                    "$ref": "#/components/messages/Party.QueueUpdatedEvent"
                },
                "Party.UpdatedEvent": {
                    "$ref": "#/components/messages/Party.UpdatedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "privateParty": {
            "address": "private-party.{code}",
            "messages": {
                "UpcomingSong.RemovedEvent": {
                    "$ref": "#/components/messages/UpcomingSong.RemovedEvent"
                },
                "UpcomingSong.UpdatedEvent": {
                    "$ref": "#/components/messages/UpcomingSong.UpdatedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "spotifyToken": {
            "address": "spotifytoken.{userId}",
            "messages": {
                "User.SpotifyAccessTokenUpdatedEvent": {
                    "$ref": "#/components/messages/User.SpotifyAccessTokenUpdatedEvent"
                }
            },
            "parameters": {
                "userId": {
                    "description": "User id"
                }
            }
        },
        "partyMembers": {
            "address": "presence-party.{code}.members",
            "description": "Presence channel (Echo name party.{code}.members). Joinable only by non-banned Members of the Party; unknown codes, non-Members, banned Members and unauthenticated callers are refused identically. Member payload carries only nickname and avatar.",
            "messages": {
                "Presence.MemberAdded": {
                    "$ref": "#/components/messages/Presence.MemberAdded"
                },
                "Presence.MemberRemoved": {
                    "$ref": "#/components/messages/Presence.MemberRemoved"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "partyMember": {
            "address": "private-party.{code}.member.{memberId}",
            "description": "Private per-Member channel (Echo name party.{code}.member.{memberId}). Authorisable only by that Member's own user while not banned; carries Request rejection notices and Request decision notices (pending, approved, rejected, removed).",
            "messages": {
                "Party.RequestRejectedEvent": {
                    "$ref": "#/components/messages/Party.RequestRejectedEvent"
                },
                "Party.RequestDecidedEvent": {
                    "$ref": "#/components/messages/Party.RequestDecidedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                },
                "memberId": {
                    "description": "Party Member id"
                }
            }
        },
        "partyModerators": {
            "address": "private-party.{code}.moderators",
            "description": "Private Moderator channel (Echo name party.{code}.moderators). Authorisable only by non-banned Host and Moderators, re-evaluated on every subscription; unknown codes, Guests, VIPs, banned Members and unauthenticated callers are refused. Carries Pending Requests and Party Log entries.",
            "messages": {
                "Party.PartyLogEntryAddedEvent": {
                    "$ref": "#/components/messages/Party.PartyLogEntryAddedEvent"
                },
                "Party.PendingRequestAddedEvent": {
                    "$ref": "#/components/messages/Party.PendingRequestAddedEvent"
                },
                "Party.PendingRequestResolvedEvent": {
                    "$ref": "#/components/messages/Party.PendingRequestResolvedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "player": {
            "address": "private-player.{code}",
            "description": "Private Player channel (Echo name player.{code}). Authorisable only by an unrevoked Player Token for that Party (ability player:connect); User sessions are refused. Carries Soloist-native command frames to the Player and accepts inbound Pusher client events (client-*) from it.",
            "messages": {
                "Player.PlayerCommandEvent": {
                    "$ref": "#/components/messages/Player.PlayerCommandEvent"
                },
                "Player.ClientFrame": {
                    "$ref": "#/components/messages/Player.ClientFrame"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        }
    },
    "components": {
        "messages": {
            "Party.QueueUpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\QueueUpdatedEvent",
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "sequence",
                        "code",
                        "now_playing",
                        "up_next",
                        "queue"
                    ],
                    "properties": {
                        "version": {
                            "type": "integer",
                            "description": "Payload schema version"
                        },
                        "sequence": {
                            "type": "integer",
                            "description": "Monotonic per-party sequence; ignore snapshots older than the last seen"
                        },
                        "code": {
                            "type": "string",
                            "description": "Party code"
                        },
                        "now_playing": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "id",
                                        "track",
                                        "status",
                                        "score",
                                        "likes",
                                        "dislikes",
                                        "requested_by"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "track": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "title",
                                                "artists",
                                                "album",
                                                "artwork_url",
                                                "duration_ms",
                                                "explicit"
                                            ],
                                            "properties": {
                                                "title": {
                                                    "type": "string"
                                                },
                                                "artists": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "album": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "artwork_url": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "duration_ms": {
                                                    "type": "integer"
                                                },
                                                "explicit": {
                                                    "type": "boolean"
                                                }
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "queued",
                                                "up_next",
                                                "playing"
                                            ]
                                        },
                                        "score": {
                                            "type": "integer"
                                        },
                                        "likes": {
                                            "type": "integer"
                                        },
                                        "dislikes": {
                                            "type": "integer"
                                        },
                                        "requested_by": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "name"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Requester nickname"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "up_next": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "id",
                                        "track",
                                        "status",
                                        "score",
                                        "likes",
                                        "dislikes",
                                        "requested_by"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "track": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "title",
                                                "artists",
                                                "album",
                                                "artwork_url",
                                                "duration_ms",
                                                "explicit"
                                            ],
                                            "properties": {
                                                "title": {
                                                    "type": "string"
                                                },
                                                "artists": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "album": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "artwork_url": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "duration_ms": {
                                                    "type": "integer"
                                                },
                                                "explicit": {
                                                    "type": "boolean"
                                                }
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "queued",
                                                "up_next",
                                                "playing"
                                            ]
                                        },
                                        "score": {
                                            "type": "integer"
                                        },
                                        "likes": {
                                            "type": "integer"
                                        },
                                        "dislikes": {
                                            "type": "integer"
                                        },
                                        "requested_by": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "name"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Requester nickname"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "queue": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "track",
                                    "status",
                                    "score",
                                    "likes",
                                    "dislikes",
                                    "requested_by"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer"
                                    },
                                    "track": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "title",
                                            "artists",
                                            "album",
                                            "artwork_url",
                                            "duration_ms",
                                            "explicit"
                                        ],
                                        "properties": {
                                            "title": {
                                                "type": "string"
                                            },
                                            "artists": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            },
                                            "album": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            },
                                            "artwork_url": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            },
                                            "duration_ms": {
                                                "type": "integer"
                                            },
                                            "explicit": {
                                                "type": "boolean"
                                            }
                                        }
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "queued",
                                            "up_next",
                                            "playing"
                                        ]
                                    },
                                    "score": {
                                        "type": "integer"
                                    },
                                    "likes": {
                                        "type": "integer"
                                    },
                                    "dislikes": {
                                        "type": "integer"
                                    },
                                    "requested_by": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "name"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ],
                                                "description": "Requester nickname"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "title": "Party.QueueUpdatedEvent",
                "x-event-class": "App\\Events\\Party\\QueueUpdatedEvent",
                "summary": "Coalesced snapshot of now playing, Up Next and the Queue; at most one per party per second. Contains no member IDs or secrets."
            },
            "Party.UpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\UpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "Party.UpdatedEvent",
                "x-event-class": "App\\Events\\Party\\UpdatedEvent"
            },
            "UpcomingSong.RemovedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\UpcomingSong\\RemovedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "UpcomingSong.RemovedEvent",
                "x-event-class": "App\\Events\\UpcomingSong\\RemovedEvent"
            },
            "UpcomingSong.UpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\UpcomingSong\\UpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "UpcomingSong.UpdatedEvent",
                "x-event-class": "App\\Events\\UpcomingSong\\UpdatedEvent"
            },
            "User.SpotifyAccessTokenUpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\User\\SpotifyAccessTokenUpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "User.SpotifyAccessTokenUpdatedEvent",
                "x-event-class": "App\\Events\\User\\SpotifyAccessTokenUpdatedEvent"
            },
            "Presence.MemberAdded": {
                "contentType": "application/json",
                "name": "pusher:member_added",
                "title": "Presence.MemberAdded",
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "info"
                    ],
                    "properties": {
                        "id": {
                            "description": "Auth identifier supplied by the presence protocol",
                            "type": [
                                "string",
                                "integer"
                            ]
                        },
                        "info": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "nickname",
                                "avatar"
                            ],
                            "properties": {
                                "nickname": {
                                    "type": "string"
                                },
                                "avatar": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "Presence.MemberRemoved": {
                "contentType": "application/json",
                "name": "pusher:member_removed",
                "title": "Presence.MemberRemoved",
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "info"
                    ],
                    "properties": {
                        "id": {
                            "description": "Auth identifier supplied by the presence protocol",
                            "type": [
                                "string",
                                "integer"
                            ]
                        },
                        "info": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "nickname",
                                "avatar"
                            ],
                            "properties": {
                                "nickname": {
                                    "type": "string"
                                },
                                "avatar": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "Party.RequestRejectedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\RequestRejectedEvent",
                "payload": {
                    "additionalProperties": false,
                    "properties": {
                        "provider_track_id": {
                            "description": "Track the Member tried to request",
                            "type": "string"
                        },
                        "reason": {
                            "description": "Specific Request rule that refused the Request",
                            "type": "string"
                        }
                    },
                    "required": [
                        "provider_track_id",
                        "reason"
                    ],
                    "type": "object"
                },
                "title": "Party.RequestRejectedEvent",
                "x-event-class": "App\\Events\\Party\\RequestRejectedEvent"
            },
            "Party.PendingRequestAddedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\PendingRequestAddedEvent",
                "payload": {
                    "additionalProperties": false,
                    "properties": {
                        "request_id": {
                            "description": "Id of the held Request",
                            "type": "integer"
                        },
                        "title": {
                            "description": "Track title",
                            "type": "string"
                        },
                        "artists": {
                            "description": "Track artists",
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "requested_by_member_id": {
                            "description": "Party Member who requested the Track",
                            "type": "integer"
                        }
                    },
                    "required": [
                        "request_id",
                        "title",
                        "artists",
                        "requested_by_member_id"
                    ],
                    "type": "object"
                },
                "title": "Party.PendingRequestAddedEvent",
                "x-event-class": "App\\Events\\Party\\PendingRequestAddedEvent"
            },
            "Party.PendingRequestResolvedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\PendingRequestResolvedEvent",
                "payload": {
                    "additionalProperties": false,
                    "properties": {
                        "request_id": {
                            "description": "Id of the Request that left Pending",
                            "type": "integer"
                        },
                        "status": {
                            "description": "Resulting status: queued, rejected or removed",
                            "type": "string"
                        }
                    },
                    "required": [
                        "request_id",
                        "status"
                    ],
                    "type": "object"
                },
                "title": "Party.PendingRequestResolvedEvent",
                "x-event-class": "App\\Events\\Party\\PendingRequestResolvedEvent"
            },
            "Party.PartyLogEntryAddedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\PartyLogEntryAddedEvent",
                "payload": {
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "description": "Party Log entry id",
                            "type": "integer"
                        },
                        "action": {
                            "description": "Party Log action key",
                            "type": "string"
                        },
                        "subject": {
                            "description": "Log entry subject, when it has one",
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "action",
                        "subject"
                    ],
                    "type": "object"
                },
                "title": "Party.PartyLogEntryAddedEvent",
                "x-event-class": "App\\Events\\Party\\PartyLogEntryAddedEvent"
            },
            "Party.RequestDecidedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\RequestDecidedEvent",
                "payload": {
                    "additionalProperties": false,
                    "properties": {
                        "request_id": {
                            "description": "Id of the Request",
                            "type": "integer"
                        },
                        "status": {
                            "description": "Current status: pending, queued, rejected or removed",
                            "type": "string"
                        },
                        "reason": {
                            "description": "Moderator's optional rejection reason",
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "required": [
                        "request_id",
                        "status",
                        "reason"
                    ],
                    "type": "object"
                },
                "title": "Party.RequestDecidedEvent",
                "x-event-class": "App\\Events\\Party\\RequestDecidedEvent"
            },
            "Player.PlayerCommandEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Player\\PlayerCommandEvent",
                "payload": {
                    "additionalProperties": true,
                    "description": "Soloist-native frame object, passed through unchanged",
                    "type": "object"
                },
                "summary": "Event name player.command",
                "title": "Player.PlayerCommandEvent",
                "x-event-class": "App\\Events\\Player\\PlayerCommandEvent"
            },
            "Player.ClientFrame": {
                "contentType": "application/json",
                "name": "client-frame",
                "payload": {
                    "additionalProperties": true,
                    "description": "Soloist-native frame object, passed through unchanged",
                    "type": "object"
                },
                "summary": "Inbound Pusher client event (any client-* name) from Soloist. Max 8192 bytes, 120 per minute per party; validated then queued as ProcessPlayerFrame.",
                "title": "Player.ClientFrame"
            }
        }
    },
    "info": {
        "description": "Reverb broadcast events. Message names are the event class names.",
        "title": "Music Party Realtime API",
        "version": "1.0.0"
    },
    "operations": {
        "publishPartyUpdated": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/party"
            },
            "messages": [
                {
                    "$ref": "#/channels/party/messages/Party.UpdatedEvent"
                },
                {
                    "$ref": "#/channels/party/messages/Party.QueueUpdatedEvent"
                }
            ]
        },
        "publishPrivatePartyUpcomingSong": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/privateParty"
            },
            "messages": [
                {
                    "$ref": "#/channels/privateParty/messages/UpcomingSong.RemovedEvent"
                },
                {
                    "$ref": "#/channels/privateParty/messages/UpcomingSong.UpdatedEvent"
                }
            ]
        },
        "publishSpotifyToken": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/spotifyToken"
            },
            "messages": [
                {
                    "$ref": "#/channels/spotifyToken/messages/User.SpotifyAccessTokenUpdatedEvent"
                }
            ]
        },
        "subscribePartyMembers": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/partyMembers"
            },
            "messages": [
                {
                    "$ref": "#/channels/partyMembers/messages/Presence.MemberAdded"
                },
                {
                    "$ref": "#/channels/partyMembers/messages/Presence.MemberRemoved"
                }
            ]
        },
        "publishPartyMemberRequestRejected": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/partyMember"
            },
            "messages": [
                {
                    "$ref": "#/channels/partyMember/messages/Party.RequestRejectedEvent"
                }
            ]
        },
        "publishPartyMemberRequestDecided": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/partyMember"
            },
            "messages": [
                {
                    "$ref": "#/channels/partyMember/messages/Party.RequestDecidedEvent"
                }
            ]
        },
        "publishPartyModerators": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/partyModerators"
            },
            "messages": [
                {
                    "$ref": "#/channels/partyModerators/messages/Party.PartyLogEntryAddedEvent"
                },
                {
                    "$ref": "#/channels/partyModerators/messages/Party.PendingRequestAddedEvent"
                },
                {
                    "$ref": "#/channels/partyModerators/messages/Party.PendingRequestResolvedEvent"
                }
            ]
        },
        "publishPlayerCommand": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/player"
            },
            "messages": [
                {
                    "$ref": "#/channels/player/messages/Player.PlayerCommandEvent"
                }
            ]
        },
        "subscribePlayerFrame": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/player"
            },
            "messages": [
                {
                    "$ref": "#/channels/player/messages/Player.ClientFrame"
                }
            ]
        }
    }
}
