{
    "asyncapi": "3.0.0",
    "channels": {
        "party": {
            "address": "party.{code}",
            "messages": {
                "Party.QueueUpdatedEvent": {
                    "$ref": "#/components/messages/Party.QueueUpdatedEvent"
                },
                "Party.UpdatedEvent": {
                    "$ref": "#/components/messages/Party.UpdatedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "privateParty": {
            "address": "private-party.{code}",
            "messages": {
                "UpcomingSong.RemovedEvent": {
                    "$ref": "#/components/messages/UpcomingSong.RemovedEvent"
                },
                "UpcomingSong.UpdatedEvent": {
                    "$ref": "#/components/messages/UpcomingSong.UpdatedEvent"
                }
            },
            "parameters": {
                "code": {
                    "description": "Party code"
                }
            }
        },
        "spotifyToken": {
            "address": "spotifytoken.{userId}",
            "messages": {
                "User.SpotifyAccessTokenUpdatedEvent": {
                    "$ref": "#/components/messages/User.SpotifyAccessTokenUpdatedEvent"
                }
            },
            "parameters": {
                "userId": {
                    "description": "User id"
                }
            }
        }
    },
    "components": {
        "messages": {
            "Party.QueueUpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\QueueUpdatedEvent",
                "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "sequence",
                        "code",
                        "now_playing",
                        "up_next",
                        "queue"
                    ],
                    "properties": {
                        "version": {
                            "type": "integer",
                            "description": "Payload schema version"
                        },
                        "sequence": {
                            "type": "integer",
                            "description": "Monotonic per-party sequence; ignore snapshots older than the last seen"
                        },
                        "code": {
                            "type": "string",
                            "description": "Party code"
                        },
                        "now_playing": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "id",
                                        "track",
                                        "status",
                                        "score",
                                        "requested_by"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "track": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "title",
                                                "artists",
                                                "album",
                                                "artwork_url",
                                                "duration_ms",
                                                "explicit"
                                            ],
                                            "properties": {
                                                "title": {
                                                    "type": "string"
                                                },
                                                "artists": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "album": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "artwork_url": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "duration_ms": {
                                                    "type": "integer"
                                                },
                                                "explicit": {
                                                    "type": "boolean"
                                                }
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "queued",
                                                "up_next",
                                                "playing"
                                            ]
                                        },
                                        "score": {
                                            "type": "integer"
                                        },
                                        "requested_by": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "name"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Requester nickname"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "up_next": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "id",
                                        "track",
                                        "status",
                                        "score",
                                        "requested_by"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "track": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "title",
                                                "artists",
                                                "album",
                                                "artwork_url",
                                                "duration_ms",
                                                "explicit"
                                            ],
                                            "properties": {
                                                "title": {
                                                    "type": "string"
                                                },
                                                "artists": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "album": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "artwork_url": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "duration_ms": {
                                                    "type": "integer"
                                                },
                                                "explicit": {
                                                    "type": "boolean"
                                                }
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "queued",
                                                "up_next",
                                                "playing"
                                            ]
                                        },
                                        "score": {
                                            "type": "integer"
                                        },
                                        "requested_by": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "name"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Requester nickname"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "queue": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "track",
                                    "status",
                                    "score",
                                    "requested_by"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer"
                                    },
                                    "track": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "title",
                                            "artists",
                                            "album",
                                            "artwork_url",
                                            "duration_ms",
                                            "explicit"
                                        ],
                                        "properties": {
                                            "title": {
                                                "type": "string"
                                            },
                                            "artists": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            },
                                            "album": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            },
                                            "artwork_url": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            },
                                            "duration_ms": {
                                                "type": "integer"
                                            },
                                            "explicit": {
                                                "type": "boolean"
                                            }
                                        }
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "queued",
                                            "up_next",
                                            "playing"
                                        ]
                                    },
                                    "score": {
                                        "type": "integer"
                                    },
                                    "requested_by": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "name"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ],
                                                "description": "Requester nickname"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "title": "Party.QueueUpdatedEvent",
                "x-event-class": "App\\Events\\Party\\QueueUpdatedEvent",
                "summary": "Coalesced snapshot of now playing, Up Next and the Queue; at most one per party per second. Contains no member IDs or secrets."
            },
            "Party.UpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\Party\\UpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "Party.UpdatedEvent",
                "x-event-class": "App\\Events\\Party\\UpdatedEvent"
            },
            "UpcomingSong.RemovedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\UpcomingSong\\RemovedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "UpcomingSong.RemovedEvent",
                "x-event-class": "App\\Events\\UpcomingSong\\RemovedEvent"
            },
            "UpcomingSong.UpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\UpcomingSong\\UpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "UpcomingSong.UpdatedEvent",
                "x-event-class": "App\\Events\\UpcomingSong\\UpdatedEvent"
            },
            "User.SpotifyAccessTokenUpdatedEvent": {
                "contentType": "application/json",
                "name": "App\\Events\\User\\SpotifyAccessTokenUpdatedEvent",
                "payload": {
                    "additionalProperties": true,
                    "type": "object"
                },
                "title": "User.SpotifyAccessTokenUpdatedEvent",
                "x-event-class": "App\\Events\\User\\SpotifyAccessTokenUpdatedEvent"
            }
        }
    },
    "info": {
        "description": "Reverb broadcast events. Message names are the event class names.",
        "title": "Music Party Realtime API",
        "version": "1.0.0"
    },
    "operations": {
        "publishPartyUpdated": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/party"
            },
            "messages": [
                {
                    "$ref": "#/channels/party/messages/Party.UpdatedEvent"
                },
                {
                    "$ref": "#/channels/party/messages/Party.QueueUpdatedEvent"
                }
            ]
        },
        "publishPrivatePartyUpcomingSong": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/privateParty"
            },
            "messages": [
                {
                    "$ref": "#/channels/privateParty/messages/UpcomingSong.RemovedEvent"
                },
                {
                    "$ref": "#/channels/privateParty/messages/UpcomingSong.UpdatedEvent"
                }
            ]
        },
        "publishSpotifyToken": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/spotifyToken"
            },
            "messages": [
                {
                    "$ref": "#/channels/spotifyToken/messages/User.SpotifyAccessTokenUpdatedEvent"
                }
            ]
        }
    }
}
