{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "-p",
                "musicparty",
                "exec",
                "-T",
                "-e",
                "XDEBUG_MODE=off",
                "musicparty",
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
