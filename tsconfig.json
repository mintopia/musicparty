{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "lib": ["ESNext", "DOM"],
        "types": ["vite/client"],
        "paths": {"@/*": ["./resources/js/*"]}
    },
    "include": ["resources/js/inertia.ts", "resources/js/types.ts", "resources/js/pages/**/*", "resources/js/layouts/**/*", "resources/js/lib/**/*", "resources/js/composables/**/*", "resources/js/tests/**/*", "resources/js/components/**/*", "resources/js/routes/**/*", "resources/js/wayfinder/**/*", "resources/js/actions/**/*"]
}
