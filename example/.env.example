# Copy to .env and fill in every value. See README.md for how to generate each one.

# Public URL users browse to, including https:// and with no trailing slash.
APP_URL=https://music.example.com
# Laravel encryption key, "base64:..." (32 random bytes).
APP_KEY=

# User and group the containers run as. Must own ./logs (see `id -u` and `id -g`).
PUID=1000
PGID=1000

# MariaDB database, user and password (replace change-me). The database container creates them on first start.
DB_DATABASE=musicparty
DB_USERNAME=musicparty
DB_PASSWORD=change-me

# Websocket (Reverb) credentials shared by the containers and the browser's pusher client.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
