includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

services:
    -
        class: Tests\Architecture\PHPStan\CrossContextWriteRule
        arguments:
            contexts: Tests\Architecture\Support\ArchitectureRules::contexts()
        tags:
            - phpstan.rules.rule

parameters:
    level: 8
    paths:
        - app
